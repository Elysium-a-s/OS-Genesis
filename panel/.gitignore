# Flutter/Dart build output and tool state. The panel gained a build system, so
# these appear as soon as anyone runs `flutter pub get`.
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies

# Generated by `flutter create`. The web template is still produced in CI; the
# iOS project is versioned (ELYSIUM-360), because an installable app needs an
# Info.plist and a bundle identifier that nobody regenerates by accident.
# `ios/.gitignore` keeps the machine-specific parts out on its own.
web/

# IDE and scaffolding state left by `flutter create`.
.idea/
.metadata
*.iml
