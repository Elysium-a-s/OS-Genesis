{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OS Genesis v1 domain messages",
  "description": "Wire contract for household, device, capability, observation, and command snapshots.",
  "oneOf": [
    {
      "$ref": "#/$defs/household"
    },
    {
      "$ref": "#/$defs/device"
    },
    {
      "$ref": "#/$defs/capability"
    },
    {
      "$ref": "#/$defs/observation"
    },
    {
      "$ref": "#/$defs/command"
    }
  ],
  "$defs": {
    "household": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "household_id",
        "name",
        "time_zone"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "household"
        },
        "household_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "household_id",
        "device_id",
        "name",
        "provider",
        "availability"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "device"
        },
        "household_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "room_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "provider_device_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "availability": {
          "enum": [
            "online",
            "offline",
            "unknown"
          ]
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "household_id",
        "device_id",
        "capability_id",
        "capability_type",
        "readable",
        "writable",
        "value_type"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "capability"
        },
        "household_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "capability_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "readable": {
          "type": "boolean"
        },
        "writable": {
          "type": "boolean"
        },
        "value_type": {
          "enum": [
            "boolean",
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "household_id",
        "device_id",
        "capability_id",
        "value",
        "observed_at",
        "received_at",
        "quality",
        "source",
        "correlation_id"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "observation"
        },
        "household_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "value": {
          "type": [
            "boolean",
            "number",
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "quality": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "quality": {
                "const": "unknown"
              }
            },
            "required": [
              "quality"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "quality": {
                "enum": [
                  "fresh",
                  "stale"
                ]
              }
            },
            "required": [
              "quality"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "boolean",
                  "number",
                  "string"
                ]
              }
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "household_id",
        "command_id",
        "device_id",
        "capability_id",
        "operation",
        "value",
        "actor",
        "idempotency_key",
        "correlation_id",
        "requested_at",
        "status",
        "status_changed_at",
        "confirmation_level"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "command"
        },
        "household_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "operation": {
          "const": "set"
        },
        "value": {
          "type": [
            "boolean",
            "number",
            "string"
          ]
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_type",
            "actor_id"
          ],
          "properties": {
            "actor_type": {
              "enum": [
                "user",
                "service",
                "automation"
              ]
            },
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "status_changed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "status": {
          "enum": [
            "created",
            "authorized",
            "queued",
            "sent",
            "provider_confirmed",
            "device_confirmed",
            "rejected",
            "timed_out",
            "unknown",
            "failed"
          ]
        },
        "confirmation_level": {
          "enum": [
            "none",
            "provider",
            "device"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference",
            "at"
          ],
          "properties": {
            "kind": {
              "enum": [
                "provider_ack",
                "device_observation"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "provider_confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "confirmation_level": {
                "const": "provider"
              },
              "evidence": {
                "properties": {
                  "kind": {
                    "const": "provider_ack"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "device_confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "confirmation_level": {
                "const": "device"
              },
              "evidence": {
                "properties": {
                  "kind": {
                    "const": "device_observation"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "created",
                  "authorized",
                  "queued",
                  "sent",
                  "rejected",
                  "timed_out",
                  "failed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "confirmation_level": {
                "const": "none"
              }
            },
            "not": {
              "required": [
                "evidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "confirmation_level": {
                "enum": [
                  "none",
                  "provider"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "rejected",
                  "timed_out",
                  "unknown",
                  "failed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  }
}
